            android:textColor="@color/scraphead_blue"
            android:textSize="20sp" />

        <RadioButton
            android:id="@+id/lowTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:buttonTint="@color/scraphead_yellow"
            android:onClick="lowTaskclick"
            android:text="Far Range"
            android:textColor="@color/scraphead_blue"
            android:textSize="20sp" />

