            android:text="Does the robot lift itself up?"
            android:textAlignment="center"
            android:textColor="@color/scraphead_yellow"
            android:textSize="20sp" />

        <RadioButton
            android:id="@+id/liftNO"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:buttonTint="@color/scraphead_yellow"
            android:onClick="shuttleAutoClick"
            android:text="No"
            android:textColor="@color/scraphead_blue"
            android:textSize="20sp" />

        <RadioButton
            android:id="@+id/basketAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:buttonTint="@color/scraphead_yellow"
            android:onClick="basketAutoClick"
            android:text="Yes"
            android:textColor="@color/scraphead_blue"
            android:textSize="20sp" />

    </RadioGroup>

