        android:id="@+id/AutoCyclesAverage"
        android:layout_width="215dp"
        android:layout_height="60dp"
        android:background="@color/scraphead_blue"
        android:ems="10"
        android:hint="Auto Cycles Avg."
        android:inputType="number"
        android:textAlignment="center"
        android:textColor="@color/scraphead_yellow"
        android:textColorHint="@color/scraphead_yellow"
        android:textSize="25sp"
        tools:layout_editor_absoluteX="373dp"
        tools:layout_editor_absoluteY="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>